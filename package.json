{
    "name":  "cosine-bus-tracker",
    "version":  "0.1.0",
    "description":  "Real-time school bus tracking and arrival estimates",
    "main":  "server.js",
    "scripts":  {
                    "start":  "node server.js",
                    "dev":  "nodemon server.js",
                    "build:css":  "tailwindcss -i ./src/input.css -o ./public/css/style.css --minify",
                    "watch:css":  "tailwindcss -i ./src/input.css -o ./public/css/style.css --watch",
                    "test":  "node --test",
                    "register:bus":  "node scripts/register-bus.js",
                    "build":  "node scripts/build.js"
                },
    "license":  "ISC",
    "dependencies":  {
                         "@fontsource/cormorant-garamond":  "5.3.0",
                         "@fontsource/jost":  "5.3.0",
                         "dotenv":  "^18.0.9",
                         "ejs":  "^7.0.2",
                         "express":  "^5.3.0",
                         "helmet":  "^8.3.0",
                         "leaflet":  "1.9.4"
                     },
    "devDependencies":  {
                            "nodemon":  "^3.1.14",
                            "tailwindcss":  "^3.4.19"
                        },
    "engines":  {
                    "node":  "22.x"
                }
}
