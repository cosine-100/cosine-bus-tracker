<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="app-layout"><%- include('../partials/sidebar') %>
<main id="main" class="workspace" data-driver>
  <div class="page-heading"><div><span class="eyebrow">DRIVER VIEW</span><h1>Driver tracking</h1></div><span class="date-chip">Set up before driving</span></div>
  <section class="commute-hero driver-hero"><div class="hero-copy"><span class="hero-kicker">KEEP YOUR CAMPUS CONNECTED</span><h2>Share the journey<br><em>Drive with confidence</em></h2><p>Connect your assigned bus and start your trip.<br>Location sharing begins only when you choose.</p><a class="hero-link" href="#driver-bus">Connect your bus <%- include('../partials/icon',{name:'arrow'}) %></a></div><%- include('../partials/route-art') %></section>
<aside class="journey-advice" aria-label="Journey advice"><strong>Before you drive</strong><p>Connect your bus and start sharing before you set off. Keep your screen awake during the trip.</p></aside>
  <ol class="driver-flow" aria-label="Trip setup steps"><li data-step="connect"><b>01</b><span>Connect your bus</span></li><li data-step="start"><b>02</b><span>Start your trip</span></li><li data-step="share"><b>03</b><span>Share location</span></li></ol>
  <div class="driver-grid">
    <section class="panel connect-panel"><div class="panel-heading"><h2>Connect your bus</h2><button class="text-button" type="button" data-disconnect hidden>Disconnect</button></div><p class="panel-description">Use the bus ID and private key from your fleet operator.</p><form data-connect class="connect-form"><label for="driver-bus">Bus ID</label><input id="driver-bus" class="field" maxlength="40" required autocomplete="off" placeholder="Your assigned bus ID"><label for="driver-key">Private driver key</label><div class="password-field"><input id="driver-key" type="password" class="field" required autocomplete="off" placeholder="Enter your private key"><button type="button" class="password-toggle" data-key-toggle aria-controls="driver-key" aria-pressed="false">Show</button></div><button class="btn btn-gold" data-connect-button><span data-connect-label>Connect bus</span><%- include('../partials/icon',{name:'arrow'}) %></button></form><p class="secure-note">Your key is held in this page's memory and is cleared on disconnect.</p></section>
    <section class="panel phone-panel"><div class="panel-heading"><h2>Phone & connection</h2><span class="badge" data-network-status>Checking</span></div><dl class="phone-grid">
      <% [ ['bus','Assigned bus','Not connected'], ['route','Assigned route','Not connected'], ['permission','Location permission','Not requested'], ['coordinates','Coordinates','Waiting for GPS'], ['accuracy','GPS accuracy','Not available'], ['sent','Last update sent','None yet'], ['screen','Screen awake','Not requested'], ['server','Server connection','Not connected'] ].forEach(function(row) { %>
      <div class="phone-item"><dt><%= row[1] %></dt><dd data-status="<%= row[0] %>"><%= row[2] %></dd></div>
      <% }); %>
    </dl><div class="trip-status-bar"><span>TRIP STATUS</span><strong data-status="trip">Not started</strong></div></section>
  </div>
  <section id="trip-controls" class="panel trip-panel"><div class="panel-heading"><h2>Trip controls</h2><span class="small-tag" data-next-action>CONNECT YOUR BUS FIRST</span></div><p id="trip-help" class="panel-description" data-trip-help>Connect your assigned bus above to unlock trip controls.</p><div class="trip-actions"><button class="btn btn-outline" data-action="start" disabled>Start trip</button><button class="btn btn-gold" data-action="share" disabled>Start sharing <%- include('../partials/icon',{name:'arrow'}) %></button><button class="btn btn-outline" data-action="pause" disabled>Stop sharing</button><button class="btn btn-outline" data-action="end" disabled>End trip</button></div><p class="driver-message" role="status" aria-live="polite" data-driver-message>Connect your assigned bus to begin.</p></section>
  <section id="tracking" class="panel driver-map-panel"><div class="panel-heading"><h2>Location preview</h2><button class="text-button" type="button" data-map-fit disabled><%- include('../partials/icon',{name:'expand'}) %>Recenter</button></div><div class="map-wrap"><div id="driver-map" class="tracker-map" aria-label="Driver location map"></div><div class="map-empty-overlay" data-map-empty><strong>Your location stays private until you share</strong><p>Connect your bus and start sharing to see your phone's GPS position.</p></div></div><p class="map-caption" data-map-message>Start sharing to show your real GPS position.</p><p class="map-health" data-map-health role="status" hidden></p></section>
  <div class="bottom-note"><p>Keep this page open while sharing. Screen-awake support depends on your phone. Stop sharing before closing the page; positions older than 45 seconds are hidden.</p></div>
</main></div>
<%- include('../partials/footer') %>
