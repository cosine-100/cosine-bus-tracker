<%- include('../partials/head') %><%- include('../partials/header') %>
<main id="main" class="access-page"><section class="access-story"><span class="eyebrow">COSINE BUS TRACKER</span><h1>A clearer view<br>of your daily commute</h1><p>Follow your bus, find your pickup stop, and stay connected to your campus.</p><%- include('../partials/route-art') %><a href="/student" class="text-button">Explore without signing in <%- include('../partials/icon',{name:'arrow'}) %></a></section><section class="access-card"><div class="access-heading"><span class="access-mode">Demo</span><h2><%= signup ? 'Create an account' : 'Welcome back' %></h2><p><%= signup ? 'Enter your details to get started.' : 'Sign in to continue to your dashboard.' %></p></div><form data-access-form class="access-form">
<% if(signup){ %><label for="access-name">Full name</label><input id="access-name" name="name" class="field" required maxlength="60" placeholder="Your name" autocomplete="off"><% } %>
<label for="access-email">Email address</label><input id="access-email" type="email" class="field" required maxlength="200" placeholder="you@example.com" autocomplete="off"><label for="access-password">Password</label><div class="password-field"><input id="access-password" type="password" class="field" required placeholder="Enter a test password" autocomplete="off"><button class="password-toggle" type="button" data-access-show aria-controls="access-password" aria-pressed="false">Show</button></div><fieldset><legend>Account type</legend><div class="role-picker"><label><input type="radio" name="role" value="student" checked><span>Student</span></label><label><input type="radio" name="role" value="driver"><span>Driver</span></label></div></fieldset><button class="btn btn-gold" type="submit"><%= signup ? 'Create account' : 'Sign in' %><%- include('../partials/icon',{name:'arrow'}) %></button><p data-access-status role="status" aria-live="polite"></p></form><p class="demo-notice">Demo access: use test details. No account is created, and your password is never sent or stored.</p><p class="access-switch"><%= signup ? 'Already have an account?' : 'New to Cosine?' %> <a href="<%= signup ? '/signin' : '/signup' %>"><%= signup ? 'Sign in' : 'Create an account' %></a></p></section></main><%- include('../partials/footer') %>
